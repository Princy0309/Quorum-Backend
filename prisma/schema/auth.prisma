enum UseCase {
  ORGANIZATION
  FREELANCE
  HIRE_COLLABORATE
  COMMUNITY
}

model User {
  id                       String                    @id @default(uuid())
  name                     String
  email                    String                    @unique
  passwordHash             String?
  role                     String                    @default("member")
  avatar                   String?
  googleId                 String?                   @unique
  lastLogin                DateTime?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  failedLoginAttempts      Int                       @default(0)
  lockedUntil              DateTime?
  isEmailVerified          Boolean                   @default(false)
  isOnboarded              Boolean                   @default(false)
  useCases                 UseCase[]
  passwordResetTokens      PasswordResetToken[]
  refreshTokens            RefreshToken[]
  conversationParticipants ConversationParticipant[]
  messagesSent             Message[]
  deviceTokens             DeviceToken[]
  hostedMeetings           Meeting[]
  ownedConversations       Conversation[]            @relation("GroupOwner")
  ownedCommunities         Community[]               @relation("CommunityOwner")
  communityMemberships     CommunityMember[]
  sentCommunityInvites     CommunityInvite[]         @relation("SentCommunityInvites")
  receivedCommunityInvites CommunityInvite[]         @relation("ReceivedCommunityInvites")
  communityJoinRequests    CommunityJoinRequest[]
  communityPosts           CommunityPost[]
  communityComments        CommunityComment[]
  ownedOrganizations       Organization[]            @relation("OrgOwner")
  memberships              OrganizationMember[]
  sentOrgInvites           OrganizationInvite[]      @relation("OrgInviter")
  teamMemberships          TeamMember[]
  aiInteractions           AiInteraction[]
  receivedNotifications    Notification[]            @relation("RecipientNotifications")
  triggeredNotifications   Notification[]            @relation("ActorNotifications")
  notificationPreferences  UserNotificationPreference[]
  savedItems               SavedItem[]
  savedCollections         SavedCollection[]
  calendarEvents           CalendarEvent[]           @relation("UserCalendarEvents")
  assignedTasks            TeamTask[]                @relation("AssignedTeamTasks")
  createdTasks             TeamTask[]                @relation("CreatedTeamTasks")
  createdWhiteboards       Whiteboard[]              @relation("WhiteboardCreator")
  jiraLink                 UserJiraLink?
  installedJiraOrgs        OrgJiraIntegration[]      @relation("OrgJiraInstaller")
}

model RefreshToken {
  id                     String    @id @default(uuid())
  tokenHash              String    @unique
  userId                 String
  familyId               String    @default(uuid())
  device                 String    @default("unknown")
  expiresAt              DateTime
  revokedAt              DateTime?
  rotationCache          String?
  rotationCacheExpiresAt DateTime?
  createdAt              DateTime  @default(now())
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String   @default("web")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

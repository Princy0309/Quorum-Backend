DATABASE_URL="postgresql://quorum_user:quorum_password@postgres:5432/quorum_db?schema=public"

JWT_SECRET="your-super-secret-key"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_DAYS=7

PORT=5000
NODE_ENV=development
CLIENT_URL="http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:3000,https://newquorum.me,https://api.newquorum.me"
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

REDIS_URL="redis://redis:6379"
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-3.5-flash-lite"
AI_HISTORY_RETENTION_DAYS=30

JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URI=http://localhost:5000/api/integrations/jira/oauth/callback
JIRA_ENCRYPTION_KEY=
JIRA_STATE_SECRET=
